<%# The frame of every page (LayoutV2.astro in the redesign): the sticky header with its mega menus, the page, the footer, the call/quote bar on phones, and the exit-intent popup (off on pages after a form is sent: a page's "Exit-intent popup" field). %>
<% settings = affordabox_settings %>
<% favicon = affordabox_file_url(settings.favicon) %>
<!DOCTYPE html>
<html lang="<%= website_settings["default_locale"].presence || "en" %>" class="scroll-smooth">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= preload_link_tag "affordabox/inter.woff2", crossorigin: "anonymous" %>
    <%= preload_link_tag "affordabox/oswald.woff2", crossorigin: "anonymous" %>
    <%= stylesheet_link_tag "affordabox/site" %>
    <%= website_design_tags %>
    <%= yield :head %>
    <% if favicon %>
      <link rel="icon" href="<%= favicon %>">
    <% else %>
      <%= favicon_link_tag "affordabox/favicon.svg", type: "image/svg+xml" %>
    <% end %>
    <link rel="manifest" href="/site.webmanifest">
    <link rel="sitemap" href="/sitemap.xml">
    <%= affordabox_json_ld(affordabox_local_business(area_served: content_for?(:area_served) ? content_for(:area_served).split("|") : nil)) %>
    <% if content_for?(:turnstile) %>
      <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer nonce="<%= content_security_policy_nonce %>"></script>
    <% end %>
    <%= website_scripts("head") %>
    <%= website_javascript_tags %>
  </head>
  <body class="font-sans text-neutral-800 antialiased bg-white">
    <%= render "website/shared/nav" %>
    <main id="main">
      <%= yield %>
    </main>
    <%= render "website/shared/footer" %>
    <%= render "website/shared/sticky_cta" %>
    <% if content_for(:exit_modal) != "off" && settings.exit_modal.enabled %>
      <%= render "website/shared/exit_modal" %>
    <% end %>
    <%= website_scripts("body") %>
  </body>
</html>
