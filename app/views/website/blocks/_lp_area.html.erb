<%# locals: (data:) -%>
<%# Where a service goes: a ZIP check (the Locations collection's ZIP codes) that, when it's a yes, carries the ZIP up to the page's form (#quote), and the cities that get the service, by county, as plain names: on a landing page they don't lead away (affordabox/landing.js). %>
<% service = data.service.presence || "dumpster" %>
<% cities = affordabox_locations.select { website_fields(it).services.include?(service) } %>
<% counties = cities.group_by { website_fields(it).county.to_s }.reject { |name, _| name.blank? } %>
<% id = "zip-#{SecureRandom.hex(3)}" %>
<section class="<%= affordabox_background(data.background) %>">
  <div class="container-base section-padding">
    <div class="grid gap-12 lg:grid-cols-5 lg:items-start">
      <div class="lg:col-span-2">
        <%= render "website/shared/section_head", eyebrow: data.eyebrow, heading: data.heading, intro: data.intro, align: "left" %>
        <form class="mt-8 rounded-lg bg-ink-900 p-6 text-white" data-zip-check data-areas="<%= affordabox_zip_areas.to_json %>" novalidate>
          <label for="<%= id %>" class="block font-display text-sm font-semibold uppercase tracking-wide text-brand-300">Check your ZIP</label>
          <div class="mt-3 flex gap-2">
            <input id="<%= id %>" type="text" inputmode="numeric" autocomplete="postal-code" maxlength="5" placeholder="e.g. 55376"
              class="min-w-0 flex-1 rounded-md border border-white/20 bg-white px-3.5 py-2.5 text-base text-ink-900 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30" data-zip-input>
            <button type="submit" class="btn-primary shrink-0 !px-5">Check</button>
          </div>
          <div class="mt-3 text-sm" aria-live="polite">
            <p class="font-semibold text-brand-300" data-zip-yes hidden></p>
            <p class="text-neutral-300" data-zip-no hidden>We may still be able to get there. Call <a href="<%= affordabox_tel(affordabox_toll_free) %>" data-track="phone_click" class="font-semibold text-white underline"><%= affordabox_toll_free %></a> or send a quote request and we'll confirm.</p>
          </div>
          <a href="#quote" class="btn-primary mt-4 w-full" data-zip-go hidden><%= data.button_label.presence || "Get my price" %></a>
        </form>
      </div>
      <div class="space-y-8 lg:col-span-3">
        <% counties.each_with_index do |(county, list), index| %>
          <%# herb:key index %>
          <div>
            <h3 class="flex items-center gap-2 font-display text-lg font-bold uppercase tracking-tight text-ink-900">
              <svg class="w-4 h-4 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              <%= county %> County
            </h3>
            <ul class="mt-3 flex flex-wrap gap-2">
              <% list.sort_by { [website_fields(it).tier.to_i, website_fields(it).city.to_s] }.each_with_index do |city, city_index| %>
                <%# herb:key city_index %>
                <li class="rounded-full border border-neutral-200 bg-white px-3.5 py-1.5 text-sm font-medium text-ink-800"><%= website_fields(city).city %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <% if data.footnote.present? %>
          <p class="text-sm text-neutral-500"><%= affordabox_fill(data.footnote) %></p>
        <% end %>
      </div>
    </div>
  </div>
</section>
