<%# locals: (data:) -%>
<%# A slim page title on white, the photo fading in on the right on wider screens (src/components/sections/ContainerPageTopSection.astro). %>
<% photo = affordabox_background_url(data.image) %>
<%= tag.section class: "relative w-full h-[80px] sm:h-[100px] md:h-[150px] bg-white flex items-center bg-cover bg-center title-bar", style: ("--bg-image: url('#{photo}')" if photo) do %>
  <div class="custom-container space-y-5">
    <% if data.title.present? %>
      <h1 class="text-2xl sm:text-[34px] font-bold text-[#414141] mt-2 tracking-tight"><%= data.title %></h1>
    <% end %>
  </div>
<% end %>
