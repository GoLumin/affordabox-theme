<%# locals: (data:) -%>
<%# A card per container for sale from the Containers collection (shipping-containers/buy.astro): photo, length and type, condition, words, the starting price (or Get a quote) and a button. With its Product structured data. %>
<% containers = affordabox_entries(:containers) %>
<section class="bg-neutral-50">
  <div class="container-base section-padding">
    <%= render "website/shared/section_head", eyebrow: data.eyebrow, heading: data.heading, intro: data.intro %>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <% containers.each_with_index do |container, index| %>
        <%# herb:key index %>
        <% f = website_fields(container) %>
        <article class="<%= class_names("relative flex flex-col rounded-lg border bg-white p-6 shadow-[var(--shadow-card)]", f.popular ? "border-brand-500 ring-2 ring-brand-500/20" : "border-neutral-200") %>">
          <% if f.popular %>
            <span class="absolute -top-3 left-6 z-10 inline-flex items-center rounded-full bg-brand-500 px-3 py-1 text-xs font-display font-bold uppercase tracking-wide text-white">Most popular</span>
          <% end %>
          <div class="mb-5 -mx-6 -mt-6 aspect-[16/10] overflow-hidden rounded-t-lg bg-neutral-100">
            <%= website_image_tag f.image, alt: "#{container.title} shipping container", class: "h-full w-full object-cover", sizes: "(min-width:1024px) 30vw, 90vw" %>
          </div>
          <span class="text-xs font-semibold uppercase tracking-wide text-neutral-500"><%= f.size %> · <%= f.type %></span>
          <h3 class="mt-2 font-display text-lg font-bold uppercase tracking-tight text-ink-900 leading-tight"><%= container.title %></h3>
          <p class="mt-2 text-sm font-medium text-brand-600"><%= f.condition %></p>
          <p class="mt-3 text-sm text-neutral-600 leading-relaxed flex-1"><%= f.fits %></p>
          <div class="mt-6 border-t border-neutral-100 pt-5">
            <% if f.price.present? %>
              <span class="text-xs font-semibold uppercase tracking-wide text-neutral-500">Starting at</span>
              <div class="mt-1 inline-block">
                <span class="font-display text-2xl font-bold text-ink-900"><%= affordabox_usd(f.price) %></span>
                <span class="block mt-1 h-1 w-full rounded-full bg-brand-500" aria-hidden="true"></span>
              </div>
            <% else %>
              <div class="inline-block">
                <span class="font-display text-lg font-bold text-ink-900">Get a quote</span>
                <span class="block mt-1 h-1 w-20 rounded-full bg-brand-500" aria-hidden="true"></span>
              </div>
            <% end %>
            <a href="/get-a-quote?service=Container%20%E2%80%94%20Buy&amp;model=<%= container.slug %>" class="<%= class_names("mt-5 w-full justify-center", f.popular ? "btn-primary" : "btn-secondary") %>"><%= data.button_label.presence || "Get this container" %></a>
          </div>
        </article>
      <% end %>
    </div>
  </div>
  <% prices = containers.filter_map { website_fields(it).price.presence } %>
  <% if data.schema && prices.any? %>
    <%= affordabox_json_ld(affordabox_product_schema(name: "Shipping Container for Sale", description: "New (one-trip) and used (cargo-worthy) 20ft and 40ft shipping containers for sale in Minnesota.", low: prices.min, high: prices.max)) %>
  <% end %>
</section>
