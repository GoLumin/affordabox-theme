<%# locals: (data:) -%>
<%# A heading and button, a row of outline buttons, then photo cards that slide past (src/components/sections/ShippingContainer.astro; affordabox/sliders.js). %>
<section class="custom-container !py-16 xl:!py-20">
  <div class="flex items-center justify-between md:flex-row flex-col w-full gap-6">
    <h2 class="text-4xl font-bold text-center"><%= data.title %></h2>
    <% if data.button_label.present? %>
      <%= affordabox_button data.button_label, affordabox_href(data.button_link) %>
    <% end %>
  </div>
  <% if data.filters.any? %>
    <div class="flex lg:justify-start justify-center sm:flex-row flex-col gap-4 my-12">
      <% data.filters.each_with_index do |button, index| %>
        <%# herb:key index %>
        <%= affordabox_button button.label, affordabox_href(button.link), variant: :outline %>
      <% end %>
    </div>
  <% end %>
  <div class="swiper shipping-slider" data-slider="cards">
    <div class="swiper-wrapper">
      <% data.cards.each_with_index do |card, index| %>
        <%# herb:key index %>
        <div class="swiper-slide">
          <div class="flex flex-col gap-4">
            <%= website_image_tag card.image, alt: website_plain_text(card.label), class: "border border-[#eee] bg-[#eee] p-2 rounded-md object-cover h-[250px] w-full", sizes: "(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" %>
            <a href="<%= affordabox_href(card.link) %>" class="font-light hover:text-primary duration-150"><span><%= card.label %></span></a>
          </div>
        </div>
      <% end %>
    </div>
    <div class="swiper-pagination !relative !bottom-0 mt-8"></div>
  </div>
</section>
