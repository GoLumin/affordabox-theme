<%# locals: (data:) -%>
<%# Photos in a grid that open full size (src/components/sections/ImageGallery.astro; affordabox/gallery.js). %>
<div class="custom-container relative lg:!py-20 py-16" data-gallery>
  <h2 class="text-3xl font-semibold mb-8 text-center uppercase"><%= data.title %></h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
    <% if data.images.empty? %>
      <p class="text-center text-gray-500 col-span-full">No images available.</p>
    <% end %>
    <% data.images.each_with_index do |item, index| %>
      <%# herb:key index %>
      <figure class="gallery-item rounded-lg overflow-hidden cursor-pointer" tabindex="0" role="button" aria-label="Image <%= index + 1 %>" data-gallery-item data-caption="Image <%= index + 1 %>">
        <%= website_image_tag item.image, alt: "Gallery image #{index + 1}", class: "w-full h-64 object-cover transition-opacity", sizes: "(min-width: 768px) 33vw, (min-width: 640px) 50vw, 100vw" %>
      </figure>
    <% end %>
  </div>
  <%= render "website/shared/lightbox" %>
</div>
