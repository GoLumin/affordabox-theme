<%# locals: (data:) -%>
<%# A photo beside formatted text, on either side; the photo can stay in view while long text scrolls (src/components/sections/TwoCol.astro). %>
<div class="custom-container p-6 bg-white">
  <div class="<%= class_names("flex justify-between items-start lg:gap-12 mx-auto py-10", data.sticky_image ? "lg:items-start" : "lg:items-center", data.image_on_left ? "lg:flex-row flex-col" : "lg:flex-row-reverse flex-col") %>">
    <div class="<%= class_names("flex justify-center h-full items-start lg:w-1/2 w-full", "lg:sticky top-24": data.sticky_image) %>">
      <%= website_image_tag data.image, class: "shadow-md max-h-[450px] object-cover rounded-xl", sizes: "(min-width: 1024px) 50vw, 100vw" %>
    </div>
    <div class="lg:w-1/2 w-full">
      <div class="prose prose-headings:text-primary prose-headings:font-semibold prose-a:text-primary min-w-full">
        <div class="rich-text"><%= affordabox_markdown data.body %></div>
      </div>
      <% if data.button_label.present? %>
        <div class="mt-6 w-fit"><%= affordabox_button data.button_label, affordabox_href(data.button_link) %></div>
      <% end %>
    </div>
  </div>
</div>
