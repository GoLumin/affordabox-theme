<%# locals: (data:) -%>
<%# Cards in a grid, in one of the redesign's looks: card (a bordered card with words, check marks and a button), icon (a green check square, a title and words), person (initials, a name and a role), link (a big card that is a link, with an arrow), panel (a display heading and words; a card can be dark). A note below is a dark line with an icon. %>
<% columns = {"2" => "md:grid-cols-2", "4" => "sm:grid-cols-2 lg:grid-cols-4"}.fetch(data.columns.to_s, "sm:grid-cols-2 lg:grid-cols-3") %>
<% columns = "md:grid-cols-3" if data.columns.to_s == "3" && data.style == "card" %>
<% muted = data.background == "muted" %>
<% head = data.eyebrow.present? || data.heading.present? %>
<section class="<%= affordabox_background(data.background) %>">
  <div class="container-base section-padding">
    <%= render "website/shared/section_head", eyebrow: data.eyebrow, heading: data.heading, intro: data.intro, align: data.align.presence || "center" %>
    <% gap = data.style == "panel" ? "gap-8" : (data.style == "icon" && data.cards.none? { it.body.present? } ? "gap-4" : "gap-6") %>
    <div class="<%= class_names("grid", gap, columns, "mt-12": head, "max-w-2xl mx-auto": data.style == "person") %>">
      <% data.cards.each_with_index do |card, index| %>
        <%# herb:key index %>
        <% href = affordabox_href(card.link) %>
        <% case data.style %>
        <% when "link" %>
          <a href="<%= href || "#" %>" class="group flex flex-col rounded-2xl border border-neutral-200 bg-white p-10 shadow-[var(--shadow-card)] transition-all hover:-translate-y-1 hover:border-brand-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500">
            <% if card.eyebrow.present? %>
              <span class="eyebrow"><%= card.eyebrow %></span>
            <% end %>
            <h2 class="display mt-3 text-3xl sm:text-4xl text-ink-900"><%= card.title %></h2>
            <div class="mt-4 text-neutral-600 leading-relaxed flex-1"><%= affordabox_markdown card.body %></div>
            <span class="mt-8 inline-flex items-center gap-2 font-display font-bold uppercase tracking-tight text-brand-600">
              <%= card.link_label %>
              <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
            </span>
          </a>
        <% when "icon" %>
          <% if card.body.present? %>
            <div class="rounded-lg bg-white shadow-[var(--shadow-card)] p-6">
              <span class="flex h-9 w-9 items-center justify-center rounded-md bg-brand-500"><%= render "website/shared/check", class_name: "w-5 h-5 text-white" %></span>
              <h3 class="mt-4 font-display font-bold uppercase tracking-tight text-ink-900"><%= card.title %></h3>
              <div class="mt-2 text-sm text-neutral-600 leading-relaxed"><%= affordabox_markdown card.body %></div>
            </div>
          <% else %>
            <div class="flex items-center gap-3 rounded-lg bg-white border border-neutral-200 px-5 py-4 shadow-[var(--shadow-card)]">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-brand-500"><%= render "website/shared/check", class_name: "w-4 h-4 text-white" %></span>
              <span class="font-display font-semibold uppercase tracking-tight text-ink-900"><%= card.title %></span>
            </div>
          <% end %>
        <% when "person" %>
          <div class="rounded-lg border border-neutral-200 bg-white p-6 text-center">
            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-brand-50 text-brand-600 font-display font-bold text-xl"><%= card.title.to_s.split.map { it[0] }.join %></div>
            <h3 class="mt-4 font-display font-bold uppercase tracking-tight text-ink-900"><%= card.title %></h3>
            <div class="mt-1 text-sm text-neutral-500"><%= affordabox_markdown card.body %></div>
          </div>
        <% when "panel" %>
          <div class="<%= card.dark ? "rounded-lg bg-ink-900 text-white p-8" : "rounded-lg border border-neutral-200 p-8 shadow-[var(--shadow-card)]" %>">
            <h2 class="<%= class_names("display text-2xl sm:text-3xl", card.dark ? "text-white" : "text-ink-900") %>"><%= card.title %></h2>
            <div class="<%= class_names("mt-4 leading-relaxed", card.dark ? "text-neutral-300" : "text-neutral-600") %>"><%= affordabox_markdown card.body %></div>
          </div>
        <% else %>
          <div class="<%= class_names("rounded-lg p-7 shadow-[var(--shadow-card)]", muted ? "bg-white border border-neutral-200" : "border border-neutral-200 bg-white", "transition-all hover:-translate-y-1 hover:border-brand-300": data.columns.to_s == "4") %>">
            <% if card.eyebrow.present? %>
              <span class="eyebrow"><%= card.eyebrow %></span>
            <% end %>
            <h3 class="<%= class_names("font-display font-bold uppercase tracking-tight text-ink-900", data.columns.to_s == "2" ? "text-xl" : "text-lg") %>"><%= card.title %></h3>
            <% if card.body.present? %>
              <div class="mt-3 text-sm text-neutral-600 leading-relaxed"><%= affordabox_markdown card.body %></div>
            <% end %>
            <% if card.checklist.any? %>
              <ul class="mt-4 space-y-3 text-sm text-neutral-600">
                <% card.checklist.each_with_index do |item, item_index| %>
                  <%# herb:key item_index %>
                  <li class="flex items-start gap-2"><%= render "website/shared/check", class_name: "mt-0.5 w-4 h-4 shrink-0 text-brand-500" %><span><%= item %></span></li>
                <% end %>
              </ul>
            <% end %>
            <% if href && card.link_label.present? %>
              <a href="<%= href %>" class="btn-secondary mt-7"><%= card.link_label %></a>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
    <% if data.note.present? %>
      <div class="mt-10 grid items-center gap-6 rounded-lg bg-ink-900 text-white p-8 sm:grid-cols-[auto_1fr]">
        <div class="flex h-14 w-14 items-center justify-center rounded-md bg-brand-500">
          <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 13l1.5-4.5A2 2 0 016.4 7h11.2a2 2 0 011.9 1.4L21 13M5 13h14m-9 0v4m4-4v4M7 13v-2m10 2v-2" /></svg>
        </div>
        <div class="text-lg text-neutral-200 leading-relaxed [&_strong]:text-white [&_p]:m-0"><%= affordabox_markdown data.note %></div>
      </div>
    <% end %>
  </div>
</section>
