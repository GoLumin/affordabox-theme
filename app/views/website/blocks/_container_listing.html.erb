<%# locals: (data:) -%>
<%# Containers (the Containers collection) to filter by size, condition, height and category, ten at a time, with a sidebar to call or ask for a quote (src/components/sections/StorageContainers.astro and the Leftsidebar, ContainerListings and Rightsiderbar beside it; affordabox/listing.js). The filters are the values the listed containers have; ticking them updates the address, so a filtered list can be linked to. %>
<% by_slug = website_entries(:containers).index_by(&:slug) %>
<% containers = data.containers.filter_map { by_slug[it] } %>
<% categories = containers.flat_map { website_fields(it).categories }.map(&:strip).compact_blank.uniq %>
<% filters = [
  ["Size", "size", affordabox_filter_values(containers, "size")],
  ["Condition", "condition", affordabox_filter_values(containers, "condition")],
  ["Height", "height", affordabox_filter_values(containers, "height")],
  ["Category", "category", categories]
].reject { it.last.empty? } %>
<% initial = 10 %>
<% listing = affordabox_settings.listing %>
<section class="bg-[#F7F7F7] w-full" data-listing>
  <div class="grid grid-cols-1 gap-5 p-6 max-w-7xl mx-auto lg:grid-cols-[300px_1fr_300px]">
    <div class="lg:sticky lg:top-6 self-start">
      <div class="space-y-6 bg-white lg:bg-white w-full h-full lg:h-screen lg:p-6 p-4 lg:mt-10">
        <div class="mb-4">
          <div class="flex lg:flex-col gap-2">
            <h2 class="font-bold text-2xl mb-2 text-gray-800 hidden lg:block">Filters</h2>
          </div>
        </div>
        <div class="bg-white z-10 lg:bg-transparent hidden lg:block bottom-0 lg:relative w-full lg:w-fit left-0 p-5 lg:p-0 h-[55vh] shadow lg:shadow-none lg:h-full overflow-y-scroll lg:overflow-y-hidden rounded-t-xl">
          <% filters.each_with_index do |(label, name, values), index| %>
            <%# herb:key index %>
            <div class="border-b-[1px] border-[#e8e8e8] py-[15px] w-full" role="group" aria-labelledby="filter-<%= name %>">
              <h3 id="filter-<%= name %>" class="font-semibold text-md mb-3 text-black"><%= label %></h3>
              <div class="flex flex-wrap gap-2 mt-2">
                <% values.each_with_index do |value, value_index| %>
                  <%# herb:key value_index %>
                  <label class="flex items-center gap-2 text-sm cursor-pointer">
                    <input type="checkbox" value="<%= value %>" name="<%= name %>" class="filter-checkbox peer sr-only" data-listing-filter>
                    <span class="bg-[#f0efef] text-primary p-2 min-w-8 rounded text-sm text-center peer-checked:bg-black peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-secondary transition-colors duration-200"><%= value %></span>
                  </label>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="lg:col-span-1">
      <div class="mx-auto lg:mt-10">
        <div class="flex flex-col items-center justify-center gap-4 w-full" data-listing-grid data-initial-count="<%= initial %>" data-batch-count="10">
          <% containers.each_with_index do |entry, index| %>
            <%# herb:key index %>
            <% fields = website_fields(entry) %>
            <div class="<%= class_names("product-card rounded-lg overflow-hidden shadow-sm transition w-full bg-white", hidden: index >= initial) %>"
              data-size="<%= affordabox_filter_value(fields.size) %>" data-condition="<%= fields.condition %>" data-height="<%= affordabox_filter_value(fields.height) %>"
              data-category="<%= fields.categories.map(&:strip).join("|") %>">
              <div class="flex flex-row items-center gap-2 justify-center p-4 md:p-5 w-full">
                <div class="w-1/4 h-full">
                  <%= website_image_tag fields.image, alt: website_plain_text(entry.title), class: "w-full object-contain min-h-[140px] rounded", sizes: "200px" %>
                </div>
                <div class="flex-1 min-w-[200px] flex flex-col gap-1">
                  <h3 class="text-[16px] text-wrap mb-1"><%= entry.title %></h3>
                  <% if fields.price.present? && fields.price.to_i.positive? %>
                    <p class="text-xl md:text-xl font-bold text-gray-900 mb-1">$<%= fields.price %></p>
                  <% end %>
                  <p class="text-gray-600 mb-1">Delivery By <span class="text-green-600 font-bold"><%= fields.delivery_time.presence || "3-5 days" %></span></p>
                  <div>
                    <a href="<%= affordabox_href(fields.link) %>" class="inline-block bg-secondary text-white px-6 py-2 rounded-md font-medium"><%= fields.button_label.presence || "Get a quote" %></a>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
        <% if containers.size > initial %>
          <div class="text-center mt-8">
            <button type="button" class="bg-yellow-300 text-gray-800 px-6 py-2 rounded-md hover:bg-yellow-400 font-medium" data-listing-more><%= data.show_more_label.presence || "Show More" %></button>
          </div>
        <% end %>
      </div>
    </div>

    <div class="rounded-lg shadow-sm lg:mt-10 lg:h-fit overflow-hidden">
      <section class="p-6 border-b border-gray-200">
        <div class="text-gray-600 mb-4 prose"><%= affordabox_markdown data.sidebar %></div>
        <% if data.button_label.present? %>
          <%= affordabox_button data.button_label, affordabox_href(data.button_link) %>
        <% end %>
      </section>
      <% if listing.steps.any? %>
        <section class="p-6 border-b border-gray-200">
          <h2 class="text-xl font-bold text-primary mb-4"><%= listing.process_heading %></h2>
          <ul class="space-y-4">
            <% listing.steps.each_with_index do |step, index| %>
              <%# herb:key index %>
              <li class="flex items-center gap-3">
                <div class="flex-shrink-0"><%= website_image_tag step.icon, alt: "", class: "w-6 h-full object-contain", sizes: "24px" %></div>
                <p class="font-medium text-gray-700 text-sm"><%= step.title %></p>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>
      <% if listing.reasons.any? %>
        <section class="p-6">
          <h2 class="text-xl font-bold text-primary mb-4"><%= listing.reasons_heading %></h2>
          <div class="slider-container relative" data-reasons>
            <div class="slider overflow-hidden bg-gray-100 rounded-lg">
              <div class="slider-track flex transition-transform duration-300 ease-in-out" data-reasons-track>
                <% listing.reasons.each_with_index do |reason, index| %>
                  <%# herb:key index %>
                  <div class="slider-item min-w-full p-4">
                    <div class="flex flex-col items-center justify-center gap-3">
                      <div class="w-full max-w-[200px]"><%= website_image_tag reason.icon, alt: "", class: "w-12 mx-auto h-auto rounded-lg object-cover", sizes: "48px" %></div>
                      <div class="text-center text-primary text-sm font-light leading-relaxed reason-text"><%= affordabox_markdown reason.text %></div>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
            <% if listing.reasons.size > 1 %>
              <div class="slider-dots flex justify-center gap-2 mt-4">
                <% listing.reasons.each_index do |index| %>
                  <%# herb:key index %>
                  <button type="button" class="<%= class_names("slider-dot w-2 h-2 rounded-full hover:bg-gray-500 transition-colors focus:outline-none focus:ring-2 focus:ring-secondary", index.zero? ? "bg-gray-800" : "bg-gray-300") %>" aria-label="Go to slide <%= index + 1 %>" data-reasons-dot="<%= index %>"></button>
                <% end %>
              </div>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  </div>
</section>
