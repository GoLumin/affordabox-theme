<%# locals: (data:) -%>
<%# A card per size from the Portable sizes collection (portable-storage/index.astro), with a note below and the Product structured data when there's a price. %>
<% sizes = affordabox_entries("portable-sizes") %>
<section class="bg-white">
  <div class="container-base section-padding">
    <div class="text-center max-w-2xl mx-auto">
      <% if data.eyebrow.present? %>
        <span class="eyebrow eyebrow-center"><%= data.eyebrow %></span>
      <% end %>
      <h2 class="display mt-3 text-3xl sm:text-4xl text-ink-900"><%= data.heading %></h2>
      <div class="mt-4 text-neutral-600 [&_strong]:text-ink-900"><%= affordabox_markdown data.intro %></div>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <% sizes.each_with_index do |size, index| %>
        <%# herb:key index %>
        <% f = website_fields(size) %>
        <div class="<%= class_names("relative rounded-lg border p-6 flex flex-col", f.popular ? "border-brand-500 ring-1 ring-brand-500 shadow-[var(--shadow-card)]" : "border-neutral-200") %>">
          <% if f.popular %>
            <span class="absolute -top-3 left-6 inline-flex items-center rounded-full bg-brand-500 px-3 py-1 text-xs font-display font-bold uppercase tracking-wide text-white">Most popular</span>
          <% end %>
          <h3 class="font-display text-2xl font-bold uppercase tracking-tight text-ink-900"><%= size.title %></h3>
          <p class="mt-1 text-sm font-medium text-brand-600"><%= f.rooms %></p>
          <p class="mt-3 text-sm text-neutral-600 leading-relaxed flex-1"><%= f.fits %></p>
          <dl class="mt-4 border-t border-neutral-200 pt-4 text-sm">
            <dt class="sr-only">Dimensions</dt>
            <dd class="text-neutral-700"><%= f.dims %></dd>
          </dl>
          <a href="/get-a-quote?service=Portable%20Storage&amp;size=<%= size.slug %>" data-track="size_quote" class="btn-secondary mt-5 w-full justify-center"><%= data.button_label.presence || "Get this size" %></a>
        </div>
      <% end %>
    </div>
    <% if data.footnote.present? %>
      <div class="mt-8 rounded-lg bg-neutral-50 border border-neutral-200 p-6 text-sm text-neutral-700 [&_strong]:text-ink-900"><%= affordabox_markdown data.footnote %></div>
    <% end %>
  </div>
  <% if data.schema_price.present? %>
    <%= affordabox_json_ld(affordabox_product_schema(name: "Portable Storage Rental", low: data.schema_price,
      description: "Ground-level portable storage units delivered to your driveway with the Mule Delivery System, month-to-month across Minnesota's NW metro and Wright County.")) %>
  <% end %>
</section>
