<%# locals: (data:) -%>
<%# The request-a-quote form (src/components/forms/QuoteForm.svelte), drawn by hand from the CMS's "quote" form (Forms › Quote request): its choices come from the form, and it posts to the Forms plugin, which checks the honeypot, its rate limit, Cloudflare Turnstile (when Settings › Forms has its keys) and the fields, sends the emails and the lead webhook. "What can we help you with?" shows the questions for that kind of request; the others stay out of what's sent. On success the visitor goes to /thank-you (affordabox/quote_form.js). %>
<% form = affordabox_quote_form %>
<% id = "quote-#{Zlib.crc32(data.to_h.to_json).to_s(36)}" %>
<% field = ->(name) { website_form_field(form, name)["name"] } %>
<% input = "w-full p-4 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-secondary focus:border-transparent transition-all" %>
<% label = "block text-gray-700 font-medium mb-2" %>
<% card = "bg-white rounded-lg shadow-sm p-6 space-y-6" %>
<% card_title = "text-2xl font-semibold text-primary border-b border-gray-200 pb-3" %>
<section id="quote-form" class="bg-[#E8EDEC] py-16 px-4">
  <div class="custom-container">
    <div class="flex flex-col items-center justify-center space-y-8 text-center mb-16">
      <% if data.eyebrow.present? %>
        <p class="text-2xl uppercase font-bold border-b-2 border-primary pb-1"><%= data.eyebrow %></p>
      <% end %>
      <h2 class="text-4xl md:text-5xl font-bold text-primary uppercase"><%= data.heading %></h2>
      <% if data.intro.present? %>
        <div class="text-gray-600 text-lg max-w-2xl"><%= data.intro %></div>
      <% end %>
    </div>

    <% if form %>
      <form id="<%= id %>" method="post" action="<%= api_form_submissions_path(form_slug: form.slug) %>" class="max-w-4xl mx-auto space-y-8" novalidate
        data-quote-form data-honeypot="<%= Form::HONEYPOT_FIELD %>" data-redirect="/thank-you">
        <p hidden aria-hidden="true"><label>Leave this empty: <input name="<%= Form::HONEYPOT_FIELD %>" tabindex="-1" autocomplete="off"></label></p>
        <% %w[gclid gbraid wbraid fbclid msclkid ttclid utm_source utm_medium utm_campaign utm_term utm_content landing_page referrer page_url].each_with_index do |name, index| %>
          <%# herb:key index %>
          <input type="hidden" name="<%= field.(name) %>" value="" data-attribution>
        <% end %>
        <input type="hidden" name="<%= field.(:sizes_needed) %>" value="" data-sizes>
        <div class="text-sm text-gray-600 flex justify-end">"<span class="text-red-500">*</span>" indicates required fields</div>

        <div class="bg-white rounded-lg shadow-sm p-6">
          <label for="<%= id %>-inquiry" class="block text-2xl font-semibold text-primary mb-6">What can we help you with? <span class="text-red-500">*</span></label>
          <%= render "website/shared/quote_select", form:, input:, name: :inquiry_type, id: "#{id}-inquiry", prompt: "- Make a Selection -" %>
          <p class="text-red-600 text-sm mt-1" data-error-for="inquiry_type" hidden></p>
        </div>

        <div class="<%= card %>" data-section="dumpsters" hidden>
          <h3 class="<%= card_title %>">Roll-off Dumpster Request</h3>
          <input type="hidden" name="<%= field.(:service_type) %>" value="dumpster-transit">
          <div>
            <label for="<%= id %>-dumpster-location" class="<%= label %>">Location</label>
            <%= render "website/shared/quote_select", form:, input:, name: :location, id: "#{id}-dumpster-location", prompt: "Select Location" %>
          </div>
          <div>
            <label for="<%= id %>-dumpster-zip" class="<%= label %>">Destination Zip Code</label>
            <input type="text" id="<%= id %>-dumpster-zip" name="<%= field.(:delivery_zip) %>" maxlength="5" inputmode="numeric" pattern="[0-9]*" autocomplete="postal-code" class="<%= input %>">
          </div>
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div>
              <label for="<%= id %>-disposal" class="<%= label %>">What are you disposing of? <span class="text-red-500">*</span></label>
              <%= render "website/shared/quote_select", form:, input:, name: :disposal_type, id: "#{id}-disposal", prompt: "Select disposal type", selected: "Construction materials" %>
              <p class="text-red-600 text-sm mt-1" data-error-for="disposal_type" hidden></p>
            </div>
            <div>
              <label for="<%= id %>-duration" class="<%= label %>">Rental Duration</label>
              <%= render "website/shared/quote_select", form:, input:, name: :rental_duration, id: "#{id}-duration", selected: "Two weeks or less" %>
            </div>
          </div>
          <fieldset>
            <legend class="block text-gray-700 font-medium mb-3">Size(s) Needed</legend>
            <div class="grid grid-cols-2 lg:grid-cols-3 gap-3">
              <% ["10 yards", "15 yards", "20 yards", "25 yards"].each_with_index do |size, index| %>
                <%# herb:key index %>
                <label class="flex items-center space-x-3 cursor-pointer">
                  <input type="checkbox" value="<%= size %>" class="w-5 h-5 text-secondary border-gray-300 rounded focus:ring-secondary focus:ring-2" autocomplete="off" data-size-choice>
                  <span class="text-gray-700 text-sm select-none"><%= size %></span>
                </label>
              <% end %>
            </div>
          </fieldset>
        </div>

        <div class="<%= card %>" data-section="self-storage" hidden>
          <h3 class="<%= card_title %>">Self Storage Request</h3>
          <div>
            <label for="<%= id %>-storage-location" class="<%= label %>">Location</label>
            <%= render "website/shared/quote_select", form:, input:, name: :location, id: "#{id}-storage-location", prompt: "Select Location" %>
          </div>
          <div>
            <label for="<%= id %>-facility" class="<%= label %>">Facility</label>
            <%= render "website/shared/quote_select", form:, input:, name: :delivery_city, id: "#{id}-facility", prompt: "Select Facility" %>
          </div>
          <div>
            <label for="<%= id %>-move-in" class="<%= label %>">Estimated Move-In Date</label>
            <input type="date" id="<%= id %>-move-in" name="<%= field.(:delivery_date) %>" autocomplete="off" class="<%= input %>">
          </div>
          <div>
            <label for="<%= id %>-storing" class="<%= label %>">Tell us a little about what you’re storing</label>
            <textarea id="<%= id %>-storing" name="<%= field.(:what_storing) %>" class="<%= input %> h-32"></textarea>
          </div>
        </div>

        <div class="<%= card %>" data-section="portable-storage" hidden>
          <h3 class="<%= card_title %>">Portable Storage &amp; Moving Request</h3>
          <div>
            <label for="<%= id %>-portable-location" class="<%= label %>">Location</label>
            <%= render "website/shared/quote_select", form:, input:, name: :location, id: "#{id}-portable-location", prompt: "Select Location" %>
          </div>
          <div>
            <label for="<%= id %>-service" class="<%= label %>">Service Type</label>
            <%= render "website/shared/quote_select", form:, input:, name: :service_type, id: "#{id}-service", prompt: "Select Service Type", selected: "store-it", values: %w[store-it move-it keep-it] %>
          </div>
          <div>
            <label for="<%= id %>-portable-size" class="<%= label %>">Select Size</label>
            <select id="<%= id %>-portable-size" class="<%= input %> bg-white" data-size-select>
              <option value="">Select Size</option>
              <% ["8 x 8", "12 x 8", "16 x 8", "20 x 8"].each_with_index do |size, index| %>
                <%# herb:key index %>
                <option value="<%= size %>"><%= size %></option>
              <% end %>
            </select>
          </div>
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div>
              <label for="<%= id %>-portable-zip" class="<%= label %>">Initial Delivery Zip Code</label>
              <input type="text" id="<%= id %>-portable-zip" name="<%= field.(:delivery_zip) %>" maxlength="5" inputmode="numeric" pattern="[0-9]*" autocomplete="postal-code" class="<%= input %>">
            </div>
            <div data-move-only hidden>
              <label for="<%= id %>-destination" class="<%= label %>">Destination Zip Code</label>
              <input type="text" id="<%= id %>-destination" name="<%= field.(:destination_zip_code) %>" maxlength="5" inputmode="numeric" pattern="[0-9]*" autocomplete="off" class="<%= input %>">
            </div>
          </div>
        </div>

        <div class="<%= card %>" data-section="shipping-container-rentals shipping-container-sales" hidden>
          <h3 class="<%= card_title %>">Shipping Containers Request</h3>
          <input type="hidden" name="<%= field.(:service_type) %>" value="" data-shipping-service>
          <div>
            <label for="<%= id %>-shipping-location" class="<%= label %>">Location</label>
            <%= render "website/shared/quote_select", form:, input:, name: :location, id: "#{id}-shipping-location", prompt: "Select Location" %>
          </div>
          <div>
            <label for="<%= id %>-shipping-zip" class="<%= label %>">Destination Zip</label>
            <input type="text" id="<%= id %>-shipping-zip" name="<%= field.(:delivery_zip) %>" maxlength="5" inputmode="numeric" pattern="[0-9]*" autocomplete="postal-code" class="<%= input %>">
          </div>
          <div>
            <label for="<%= id %>-rent-buy" class="<%= label %>">Rent or Purchase?</label>
            <%= render "website/shared/quote_select", form:, input:, name: :rent_or_purchase, id: "#{id}-rent-buy", selected: "Rent" %>
          </div>
          <div>
            <label for="<%= id %>-container-size" class="<%= label %>">Container Size</label>
            <select id="<%= id %>-container-size" class="<%= input %> bg-white" data-size-select>
              <option value="">Select Size</option>
              <% %w[20 40].each_with_index do |size, index| %>
                <%# herb:key index %>
                <option value="<%= size %>"><%= size %></option>
              <% end %>
            </select>
          </div>
          <div>
            <label for="<%= id %>-container-type" class="<%= label %>">Container Type</label>
            <%= render "website/shared/quote_select", form:, input:, name: :features_needed, id: "#{id}-container-type", prompt: "Select Container Type" %>
          </div>
        </div>

        <div class="<%= card %>">
          <h3 class="<%= card_title %>">Your Contact Information</h3>
          <fieldset>
            <legend class="block text-gray-700 font-medium mb-3">Name <span class="text-red-500">*</span></legend>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
              <div>
                <input type="text" id="<%= id %>-first" name="<%= field.(:first_name) %>" autocomplete="given-name" class="<%= input %>" placeholder="First name" required>
                <label for="<%= id %>-first" class="block text-sm text-gray-500 mt-1">First</label>
                <p class="text-red-600 text-sm mt-1" data-error-for="first_name" hidden></p>
              </div>
              <div>
                <input type="text" id="<%= id %>-last" name="<%= field.(:last_name) %>" autocomplete="family-name" class="<%= input %>" placeholder="Last name" required>
                <label for="<%= id %>-last" class="block text-sm text-gray-500 mt-1">Last</label>
                <p class="text-red-600 text-sm mt-1" data-error-for="last_name" hidden></p>
              </div>
            </div>
          </fieldset>
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div>
              <label for="<%= id %>-email" class="<%= label %>">Email <span class="text-red-500">*</span></label>
              <input type="email" id="<%= id %>-email" name="<%= field.(:email) %>" autocomplete="email" class="<%= input %>" placeholder="your@email.com" required>
              <p class="text-red-600 text-sm mt-1" data-error-for="email" hidden></p>
            </div>
            <div>
              <label for="<%= id %>-phone" class="<%= label %>">Phone <span class="text-red-500">*</span></label>
              <input type="tel" id="<%= id %>-phone" name="<%= field.(:phone) %>" autocomplete="tel" class="<%= input %>" placeholder="(555) 123-4567" required>
              <p class="text-red-600 text-sm mt-1" data-error-for="phone" hidden></p>
            </div>
          </div>
          <div>
            <label for="<%= id %>-details" class="<%= label %>">How can we help you? <span class="text-red-500">*</span></label>
            <textarea id="<%= id %>-details" name="<%= field.(:project_details) %>" class="<%= input %> h-32 resize-y" placeholder="Tell us more about your project or any special requirements..." required></textarea>
            <p class="text-red-600 text-sm mt-1" data-error-for="project_details" hidden></p>
          </div>
        </div>

        <% if (turnstile = affordabox_turnstile) %>
          <% content_for :turnstile, "on" %>
          <div class="cf-turnstile" data-sitekey="<%= turnstile[:site_key] %>" data-theme="<%= turnstile[:theme] %>"></div>
        <% end %>

        <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-red-700" role="alert" data-form-status hidden></div>

        <div class="flex justify-start">
          <button type="submit" class="bg-secondary text-primary font-bold py-4 px-8 rounded-lg hover:opacity-90 transition-all disabled:opacity-50 disabled:cursor-not-allowed" data-busy-label="Submitting...">
            <%= form.submit_label.presence || "Submit Inquiry" %>
          </button>
        </div>
      </form>
    <% else %>
      <p class="text-center text-gray-600">Call us at <a href="<%= affordabox_tel(affordabox_sidebar.phone) %>" class="font-semibold text-primary underline"><%= affordabox_sidebar.phone %></a> and we'll take your details over the phone.</p>
    <% end %>
  </div>
</section>
