<%# locals: (data:) -%>
<%# The cities served (the Locations collection), grouped by county in the block's order, nearest first (locations/index.astro). %>
<% locations = affordabox_locations %>
<section class="bg-white">
  <div class="container-base section-padding space-y-14">
    <% data.counties.each_with_index do |county, index| %>
      <%# herb:key index %>
      <% cities = locations.select { website_fields(it).county == county["name"] }.sort_by { [website_fields(it).tier.to_i, website_fields(it).city.to_s] } %>
      <% next if cities.empty? %>
      <div>
        <div class="flex flex-wrap items-end justify-between gap-2 border-b border-neutral-200 pb-3">
          <h2 class="display text-2xl sm:text-3xl text-ink-900"><%= county["name"] %> County</h2>
          <p class="text-sm text-neutral-500 max-w-md"><%= county.blurb %></p>
        </div>
        <div class="mt-7 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          <% cities.each_with_index do |city, city_index| %>
            <%# herb:key city_index %>
            <% f = website_fields(city) %>
            <% path = website_path(city) %>
            <div class="group rounded-md border border-neutral-200 p-5 transition-colors hover:border-brand-400">
              <a href="<%= path %>" class="font-display text-lg font-bold uppercase tracking-tight text-ink-900 transition-colors group-hover:text-brand-600"><%= f.city %>, MN</a>
              <p class="mt-2 text-sm leading-relaxed text-neutral-600 line-clamp-3"><%= f.blurb %></p>
              <ul class="mt-4 flex flex-wrap gap-x-3 gap-y-1.5 text-xs font-medium">
                <% f.services.first(3).each_with_index do |service, service_index| %>
                  <%# herb:key service_index %>
                  <li><a href="<%= path %>" class="text-brand-600 hover:text-brand-700 hover:underline"><%= affordabox_service_label(service) %></a></li>
                <% end %>
              </ul>
              <a href="<%= path %>" class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-ink-900 transition-colors group-hover:text-brand-600">
                View <%= f.city %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" /></svg>
              </a>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</section>
