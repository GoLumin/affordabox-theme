<%# locals: (data:) -%>
<%# Columns of opening hours (a bold row stands out), or of features with check marks (src/components/sections/LocationTiming.astro). %>
<section class="custom-container !py-16">
  <h2 class="text-4xl font-bold text-primary mb-8"><%= data.heading %></h2>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
    <% data.columns.each_with_index do |column, index| %>
      <%# herb:key index %>
      <div class="space-y-4">
        <h3 class="text-xl font-semibold text-[#101920] border-b pb-2"><%= column.title %></h3>
        <% if column.show_features %>
          <ul class="space-y-3">
            <% column.features.each_with_index do |feature, feature_index| %>
              <%# herb:key feature_index %>
              <li class="flex items-center gap-3 text-[#2F2E2E]">
                <svg class="text-secondary w-6 h-6 shrink-0" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M20.94,11A8.26,8.26,0,0,1,21,12a9,9,0,1,1-9-9,8.83,8.83,0,0,1,4,1" fill="none" stroke="#000000" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><polyline points="21 5 12 14 8 10" fill="none" stroke="#000000" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></polyline></svg>
                <%= feature %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <dl class="space-y-2">
            <% column.rows.each_with_index do |row, row_index| %>
              <%# herb:key row_index %>
              <div class="<%= class_names("flex justify-between text-[#2F2E2E]", "font-bold": row.bold) %>">
                <dt><%= row.day %></dt>
                <dd><%= row.time %></dd>
              </div>
            <% end %>
          </dl>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
