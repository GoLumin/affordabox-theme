<%# locals: (data:) -%>
<%# Questions from the FAQs collection (one group), opening to their answers: the simple list (FaqBlock.astro), or cards under a heading (the FAQ page), with the FAQPage structured data. %>
<% faqs = affordabox_faqs(data.group) %>
<% cards = data.style == "cards" %>
<% if faqs.any? %>
  <section class="bg-white">
    <div class="<%= class_names("container-base", cards ? "py-8 first:pt-16" : "section-padding") %>">
      <div class="max-w-3xl mx-auto">
        <% if cards %>
          <h2 class="font-display font-semibold text-2xl uppercase tracking-tight text-ink-900 mb-6 flex items-center gap-3"><span class="h-5 w-1 bg-brand-500 rounded-sm"></span><%= data.heading %></h2>
          <div class="space-y-4">
            <% faqs.each_with_index do |faq, index| %>
              <%# herb:key index %>
              <details class="group bg-neutral-50 rounded-md border border-neutral-200 overflow-hidden open:border-brand-300 open:bg-white open:shadow-[var(--shadow-card)] transition-all">
                <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer list-none hover:bg-neutral-100 transition-colors">
                  <span class="font-display font-semibold uppercase tracking-tight text-ink-900"><%= faq.title %></span>
                  <svg class="w-5 h-5 text-neutral-400 shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                </summary>
                <div class="px-5 pb-5 text-neutral-600 leading-relaxed"><%= website_fields(faq).answer %></div>
              </details>
            <% end %>
          </div>
        <% else %>
          <%= render "website/shared/section_head", eyebrow: data.eyebrow.presence || "— FAQ", heading: data.heading.presence || "Frequently asked questions" %>
          <div class="mt-10 divide-y divide-neutral-200 border-t border-b border-neutral-200">
            <% faqs.each_with_index do |faq, index| %>
              <%# herb:key index %>
              <details class="group py-5">
                <summary class="flex cursor-pointer items-center justify-between gap-4 list-none">
                  <span class="font-display font-semibold text-ink-900 text-lg"><%= faq.title %></span>
                  <svg class="w-5 h-5 shrink-0 text-brand-500 transition-transform group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                </summary>
                <p class="mt-3 text-neutral-600 leading-relaxed"><%= website_fields(faq).answer %></p>
              </details>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
    <% if data.schema %>
      <%= affordabox_json_ld({"@context" => "https://schema.org", "@type" => "FAQPage",
        "mainEntity" => faqs.map { {"@type" => "Question", "name" => it.title, "acceptedAnswer" => {"@type" => "Answer", "text" => website_fields(it).answer}} }}) %>
    <% end %>
  </section>
<% end %>
