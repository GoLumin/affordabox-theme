<%# locals: (data:) -%>
<%# Where the forms land (thank-you.astro): a check, the thank-you, the phone number and two buttons, and the analytics event. %>
<% phone = affordabox_toll_free %>
<% before, after = data.call_line.to_s.split("{phone}", 2) %>
<section class="bg-neutral-50 min-h-[calc(100dvh-64px)] flex items-center" <%= tag.attributes(data: {gtag_event: data.event.presence}) %>>
  <div class="container-base max-w-xl text-center section-padding">
    <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-brand-500"><%= render "website/shared/check", class_name: "w-8 h-8 text-white" %></span>
    <h1 class="display mt-6 text-4xl sm:text-5xl text-ink-900"><%= data.heading %></h1>
    <p class="mt-5 text-lg text-neutral-600 leading-relaxed"><%= data.body %></p>
    <% if data.call_line.present? %>
      <p class="mt-4 text-neutral-600"><%= before %><% if after %><a href="<%= affordabox_tel(phone) %>" data-track="phone_click" class="font-display font-bold text-brand-600 hover:text-brand-700"><%= phone %></a><%= after %><% end %></p>
    <% end %>
    <div class="mt-9 flex flex-wrap items-center justify-center gap-4">
      <% data.buttons.each_with_index do |button, index| %>
        <%# herb:key index %>
        <a href="<%= affordabox_href(button.link) || "/" %>" class="<%= button.style == "secondary" ? "btn-secondary" : "btn-primary" %>"><%= button.label %></a>
      <% end %>
    </div>
  </div>
</section>
