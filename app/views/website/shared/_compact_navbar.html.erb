<%# The compact top bar, for pages without the sidebar (src/components/sections/AlternativeNavbar.astro): the logo, the Sidebar global's first five links and a More menu for the rest, the phone number, and the cart link on its own at the right. A link named "My account" is left out. %>
<% sidebar = affordabox_sidebar %>
<% items = sidebar.items.map { {title: it.label.to_s.strip.presence || "Untitled", href: affordabox_href(it.link), icon: it.icon} } %>
<% cart = items.find { it[:title].downcase.include?("cart") } %>
<% main = items.reject { it[:title].downcase.include?("cart") || it[:title].downcase.include?("my account") } %>
<% visible = main.first(5) %>
<% more = main.drop(5) %>
<% phone = sidebar.phone.to_s %>
<header class="bg-primary shadow-lg">
  <div class="container mx-auto !py-3 flex items-center justify-between">
    <button type="button" id="mobile-menu-toggle" class="text-white focus:outline-none xl:hidden" aria-label="Toggle Menu" aria-controls="compact-menu" aria-expanded="false">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
    </button>
    <div class="flex items-center justify-between w-full lg:w-auto">
      <a href="/" class="flex-shrink-0 mx-auto" aria-label="Home">
        <%= website_image_tag sidebar.logo, alt: "Logo", class: "h-10 w-40 object-contain", sizes: "160px", loading: :eager %>
      </a>
    </div>
    <nav class="hidden xl:flex items-center flex-1 justify-center space-x-6" aria-label="Main">
      <% visible.each_with_index do |item, index| %>
        <%# herb:key index %>
        <a href="<%= item[:href] %>" class="flex items-center space-x-2 text-[#ffffffc2] hover:text-white transition-colors text-sm font-light group"><span><%= item[:title] %></span></a>
      <% end %>
      <% if more.any? %>
        <div class="relative">
          <button type="button" id="desktop-more-toggle" class="flex items-center space-x-1 text-[#ffffffc2] hover:text-white transition-colors text-sm font-light" aria-haspopup="true" aria-expanded="false" aria-controls="desktop-more-menu">
            <span>More</span>
            <svg class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </button>
          <div id="desktop-more-menu" class="absolute top-full left-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-200 opacity-0 invisible transform -translate-y-2 transition-all duration-200 z-50">
            <div class="py-2">
              <% more.each_with_index do |item, index| %>
                <%# herb:key index %>
                <a href="<%= item[:href] %>" class="flex items-center px-4 py-2 text-gray-700 hover:bg-gray-100 hover:text-primary text-sm">
                  <%= website_image_tag item[:icon], alt: "", class: "w-4 h-4 mr-3 opacity-70", sizes: "16px" %>
                  <span><%= item[:title] %></span>
                </a>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </nav>
    <a href="<%= affordabox_tel(phone) %>" class="flex items-center space-x-2 text-secondary hover:text-secondary/80 font-bold">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="text-secondary" aria-hidden="true"><path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      <span><%= phone %></span>
    </a>
    <div class="hidden xl:flex items-center ml-auto space-x-6">
      <% if cart %>
        <a href="<%= cart[:href] %>" class="flex items-center space-x-2 text-[#ffffffc2] hover:text-white transition-colors text-sm font-light group">
          <%= website_image_tag cart[:icon], alt: "", class: "w-5 h-5 invert opacity-70 group-hover:opacity-100", sizes: "20px" %>
          <span><%= cart[:title] %></span>
        </a>
      <% end %>
    </div>
  </div>
  <nav id="compact-menu" class="hidden bg-primary mt-2 space-y-2 px-4 pb-4" aria-label="Main">
    <% main.each_with_index do |item, index| %>
      <%# herb:key index %>
      <a href="<%= item[:href] %>" class="block px-4 py-2 text-white bg-primary/20 hover:bg-primary/40 rounded text-sm font-light"><span><%= item[:title] %></span></a>
    <% end %>
  </nav>
</header>
