<%# The full-size viewer a gallery's photos open in: arrows and the keyboard step through them, Escape or a click outside closes it (affordabox/gallery.js). %>
<div class="lightbox fixed inset-0 bg-[#061b23df] z-[9999999] hidden flex-col items-center justify-center p-4" role="dialog" aria-modal="true" aria-label="Image viewer" data-lightbox>
  <button type="button" class="absolute top-4 right-4 text-white text-2xl hover:text-gray-300" aria-label="Close" data-lightbox-close>&times;</button>
  <button type="button" class="absolute left-4 text-white text-3xl top-1/2 -translate-y-1/2 hover:text-gray-300" aria-label="Previous photo" data-lightbox-prev>&#10094;</button>
  <img class="lightbox__image max-h-[80vh] max-w-[90vw] rounded-lg object-contain" src="data:," alt="" data-lightbox-image>
  <button type="button" class="absolute right-4 text-white text-3xl top-1/2 -translate-y-1/2 hover:text-gray-300" aria-label="Next photo" data-lightbox-next>&#10095;</button>
  <p class="text-white text-center mt-4" data-lightbox-caption></p>
</div>
