<%# The standard top bar (src/components/sections/Navbar.astro): the Top bar global's icon links, sliding on narrow screens and centred on wide ones (affordabox/sliders.js). %>
<header id="main-header" class="bg-primary py-4 transition-all">
  <div class="max-w-5xl mx-auto">
    <div class="swiper nav-slider" data-slider="nav">
      <div class="swiper-wrapper">
        <% website_global(:nav).items.each_with_index do |item, index| %>
          <%# herb:key index %>
          <div class="swiper-slide !max-w-[150px]">
            <div class="slide-content text-white">
              <a href="<%= affordabox_href(item.link) %>" class="flex flex-col items-center justify-center px-4">
                <%= website_image_tag item.icon, alt: "", class: "w-24 h-14 opacity-65", sizes: "96px" %>
                <span class="text-sm whitespace-nowrap"><%= item.label %></span>
              </a>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</header>
