<%# The sticky header (PrimaryNav.astro): the logo, a mega menu per product (columns of links and a photo promo, opening on hover or keyboard focus), plain links, the phone and the quote button, from the Menu global; on phones, one menu button (affordabox/nav.js). %>
<% nav = website_global(:nav) %>
<% settings = affordabox_settings %>
<% phone = settings.toll_free.to_s %>
<% tel = affordabox_tel(phone) %>
<% cta_href = affordabox_href(nav.cta_link) || "/get-a-quote" %>
<% cta_label = nav.cta_label.presence || "Get a Quote" %>
<header class="sticky top-0 z-50">
  <div class="bg-white/95 backdrop-blur-sm border-b border-neutral-200">
    <div class="container-base">
      <div class="flex items-center justify-between h-16 lg:h-18">
        <a href="/" class="flex items-center shrink-0" aria-label="<%= affordabox_name %> home">
          <%= website_image_tag settings.logo, alt: "#{affordabox_name} — Dumpsters, Containers & Storage", class: "h-8 lg:h-9 w-auto", sizes: "200px", loading: :eager %>
        </a>
        <nav class="hidden lg:flex items-center" aria-label="Primary">
          <% nav.megas.each_with_index do |mega, index| %>
            <%# herb:key index %>
            <div class="group static">
              <a href="<%= affordabox_href(mega.link) || "#" %>" class="inline-flex items-center gap-1 h-16 lg:h-18 px-3.5 text-sm font-display font-semibold uppercase tracking-wide text-ink-700 transition-colors group-hover:text-brand-600 group-focus-within:text-brand-600">
                <%= mega.label %>
                <svg class="w-3.5 h-3.5 text-neutral-400 transition-transform duration-200 group-hover:rotate-180 group-hover:text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" /></svg>
              </a>
              <div class="invisible absolute left-0 right-0 top-full z-40 translate-y-1 opacity-0 transition-all duration-200 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
                <div class="container-base pt-2 pb-4">
                  <div class="overflow-hidden rounded-xl border border-neutral-200 bg-white shadow-[var(--shadow-lift)]">
                    <div class="grid grid-cols-12">
                      <div class="col-span-8 grid grid-cols-2 gap-x-8 gap-y-6 p-8">
                        <% mega.columns.each_with_index do |column, column_index| %>
                          <%# herb:key column_index %>
                          <div>
                            <div class="mb-3 flex items-center gap-2 text-xs font-display font-semibold uppercase tracking-widest text-brand-600">
                              <span class="h-px w-4 bg-brand-500"></span><%= column.heading %>
                            </div>
                            <ul class="space-y-0.5">
                              <% column.links.each_with_index do |link, link_index| %>
                                <%# herb:key link_index %>
                                <li>
                                  <a href="<%= affordabox_href(link.link) || "#" %>" class="group/link flex items-center justify-between rounded-md px-3 py-2 -mx-3 transition-colors hover:bg-neutral-50">
                                    <span class="flex items-center gap-2">
                                      <span class="font-display font-semibold uppercase tracking-tight text-sm text-ink-900 transition-colors group-hover/link:text-brand-600"><%= link.label %></span>
                                      <% if link.badge.present? %>
                                        <span class="rounded-full bg-brand-50 px-2 py-0.5 text-[0.65rem] font-semibold uppercase tracking-wide text-brand-700"><%= link.badge %></span>
                                      <% end %>
                                    </span>
                                    <% if link.meta.present? %>
                                      <span class="text-xs font-semibold text-neutral-500 group-hover/link:text-ink-900"><%= link.meta %></span>
                                    <% end %>
                                  </a>
                                </li>
                              <% end %>
                            </ul>
                          </div>
                        <% end %>
                      </div>
                      <a href="<%= affordabox_href(mega.featured_link) || "#" %>" class="group/feat relative col-span-4 flex flex-col justify-end overflow-hidden p-7 bg-ink-900">
                        <%= website_image_tag mega.image, alt: "", class: "absolute inset-0 h-full w-full object-cover opacity-40 transition-transform duration-500 group-hover/feat:scale-105", sizes: "22vw" %>
                        <div class="absolute inset-0 bg-gradient-to-t from-ink-950 via-ink-950/75 to-ink-950/25"></div>
                        <div class="relative">
                          <div class="text-xs font-display font-semibold uppercase tracking-widest text-brand-400"><%= mega.featured_eyebrow %></div>
                          <div class="mt-2 font-display text-xl font-bold uppercase leading-tight tracking-tight text-white"><%= mega.featured_title %></div>
                          <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-display font-semibold uppercase tracking-wide text-brand-400">
                            <%= mega.featured_cta %> <span class="transition-transform group-hover/feat:translate-x-1">→</span>
                          </span>
                        </div>
                      </a>
                    </div>
                    <div class="flex items-center justify-between gap-4 border-t border-neutral-100 bg-neutral-50 px-8 py-3.5">
                      <ul class="hidden xl:flex items-center gap-5 text-xs font-medium text-neutral-600">
                        <% nav.cro_items.each_with_index do |item, item_index| %>
                          <%# herb:key item_index %>
                          <li class="flex items-center gap-1.5"><%= render "website/shared/check", class_name: "w-3.5 h-3.5 text-brand-500", stroke: 3 %><%= item %></li>
                        <% end %>
                      </ul>
                      <div class="flex items-center gap-4">
                        <a href="<%= tel %>" data-track="phone_click" class="text-sm font-display font-semibold uppercase tracking-wide text-ink-800 hover:text-brand-600"><%= phone %></a>
                        <a href="<%= cta_href %>" class="btn-primary text-xs py-2 px-4"><%= cta_label %></a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
          <% nav.links.each_with_index do |link, index| %>
            <%# herb:key index %>
            <a href="<%= affordabox_href(link.link) || "#" %>" class="inline-flex items-center h-16 lg:h-18 px-3.5 text-sm font-display font-semibold uppercase tracking-wide text-ink-700 hover:text-brand-600 transition-colors"><%= link.label %></a>
          <% end %>
        </nav>
        <div class="hidden lg:flex items-center gap-4">
          <a href="<%= tel %>" data-track="phone_click" class="text-sm font-display font-semibold uppercase tracking-wide text-ink-800 hover:text-brand-600 transition-colors"><%= phone %></a>
          <a href="<%= cta_href %>" class="btn-primary text-sm py-2.5 px-5"><%= cta_label %></a>
        </div>
        <button type="button" id="mobile-menu-btn" class="lg:hidden p-2 rounded-md text-ink-800 hover:bg-neutral-100" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
          <svg class="w-6 h-6 menu-open" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
          <svg class="w-6 h-6 menu-close hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>
    </div>
  </div>
  <div class="hazard-rule h-1.5" aria-hidden="true"></div>
  <nav id="mobile-menu" class="lg:hidden hidden border-t border-neutral-200 bg-white max-h-[calc(100dvh-4rem)] overflow-y-auto" aria-label="Menu">
    <div class="container-base py-4 space-y-2">
      <% nav.megas.each_with_index do |mega, index| %>
        <%# herb:key index %>
        <div class="border-b border-neutral-100 pb-3">
          <a href="<%= affordabox_href(mega.link) || "#" %>" class="block px-3 py-2.5 font-display font-semibold uppercase tracking-tight text-ink-900 rounded-md hover:bg-neutral-50"><%= mega.label %></a>
          <div class="mt-1 grid grid-cols-2 gap-x-4">
            <% mega.columns.each_with_index do |column, column_index| %>
              <%# herb:key column_index %>
              <div class="mb-2">
                <div class="px-3 pt-1 text-[0.65rem] font-display font-semibold uppercase tracking-widest text-brand-600"><%= column.heading %></div>
                <% column.links.each_with_index do |link, link_index| %>
                  <%# herb:key link_index %>
                  <a href="<%= affordabox_href(link.link) || "#" %>" class="flex items-center justify-between px-3 py-2 text-sm text-neutral-700 rounded-md hover:bg-neutral-50 hover:text-ink-900">
                    <span><%= link.label %></span>
                    <% if link.meta.present? %>
                      <span class="text-xs font-semibold text-neutral-400"><%= link.meta %></span>
                    <% end %>
                  </a>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
      <% nav.links.each_with_index do |link, index| %>
        <%# herb:key index %>
        <a href="<%= affordabox_href(link.link) || "#" %>" class="block px-3 py-2.5 font-display font-semibold uppercase tracking-tight text-ink-900 rounded-md hover:bg-neutral-50"><%= link.label %></a>
      <% end %>
      <div class="pt-3 space-y-3">
        <a href="<%= tel %>" class="block w-full text-center btn-secondary py-3">Call <%= phone %></a>
        <a href="<%= cta_href %>" class="block w-full text-center btn-primary py-3.5"><%= cta_label %></a>
      </div>
    </div>
  </nav>
</header>
