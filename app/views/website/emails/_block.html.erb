<%# locals: (block:, c:, sans:) -%>
<%# One of a form email's blocks (the Forms plugin's email blocks), as a table row. A large heading is the green banner. %>
<% data = block["data"].is_a?(Hash) ? block["data"] : {} %>
<% align = data["align"] == "center" ? "center" : "left" %>
<% case block["type"] %>
<% when "email_heading" %>
  <% if data["level"].blank? || data["level"] == "h1" %>
    <tr>
      <td align="center" style="background:<%= c[:green] %>;padding:30px 40px;font-family:<%= sans %>;font-size:28px;line-height:1.25;font-weight:700;color:#ffffff;"><%= data["text"] %></td>
    </tr>
  <% else %>
    <tr>
      <td align="<%= align %>" style="background:<%= c[:card] %>;padding:24px 40px 8px;font-family:<%= sans %>;font-size:<%= data["level"] == "h2" ? 22 : 18 %>px;line-height:1.3;font-weight:600;color:<%= c[:ink] %>;"><%= data["text"] %></td>
    </tr>
  <% end %>
<% when "email_text" %>
  <tr>
    <td style="background:<%= c[:card] %>;padding:24px 40px 8px;font-family:<%= sans %>;font-size:15px;line-height:1.6;color:<%= c[:ink] %>;"><%= website_rich_text(data["body"]) %></td>
  </tr>
<% when "email_button" %>
  <tr>
    <td align="<%= align %>" style="background:<%= c[:card] %>;padding:16px 40px 24px;">
      <%= tag.a data["label"].to_s, href: data["url"].to_s,
        style: "display:inline-block;background:#{c[:green]};color:#ffffff;font-family:#{sans};font-size:15px;font-weight:700;text-decoration:none;padding:14px 28px;border-radius:8px;" %>
    </td>
  </tr>
<% when "email_image" %>
  <% src = website_image_url(data["asset"]) %>
  <% if src %>
    <tr>
      <td align="<%= align %>" style="background:<%= c[:card] %>;padding:16px 40px;">
        <% image = tag.img(src:, alt: data["alt"].to_s, width: 520, style: "display:block;width:100%;max-width:520px;height:auto;border-radius:8px;border:0;") %>
        <%= data["url"].present? ? tag.a(image, href: data["url"]) : image %>
      </td>
    </tr>
  <% end %>
<% when "email_divider" %>
  <tr>
    <td style="background:<%= c[:card] %>;padding:8px 40px 16px;"><div style="border-top:1px solid <%= c[:rule] %>;font-size:0;line-height:0;">&nbsp;</div></td>
  </tr>
<% when "email_spacer" %>
  <tr>
    <td style="background:<%= c[:card] %>;height:<%= {"small" => 12, "medium" => 24, "large" => 40}.fetch(data["size"], 24) %>px;font-size:0;line-height:0;">&nbsp;</td>
  </tr>
<% when "email_submission" %>
  <tr>
    <td style="background:<%= c[:card] %>;padding:20px 40px 24px;">
      <% if data["title"].present? %>
        <p style="margin:0 0 12px;font-family:<%= sans %>;font-size:18px;font-weight:600;color:<%= c[:ink] %>;"><%= data["title"] %></p>
      <% end %>
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
        <tr data-cms-repeat="answers" data-cms-skip-empty="<%= data["skip_empty"] == true %>">
          <td valign="top" style="padding:12px 12px 12px 0;width:40%;font-family:<%= sans %>;font-size:14px;color:<%= c[:label] %>;border-bottom:1px solid <%= c[:rule] %>;">{{answer.label}}</td>
          <td valign="top" style="padding:12px 0;font-family:<%= sans %>;font-size:15px;line-height:1.5;font-weight:500;color:<%= c[:ink] %>;border-bottom:1px solid <%= c[:rule] %>;">{{answer.value}}</td>
        </tr>
      </table>
    </td>
  </tr>
<% end %>
