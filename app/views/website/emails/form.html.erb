<%# locals: (email:) -%>
<%# A form email (notification or confirmation) in the Affordabox design the Astro site's emails had (src/actions/emailTemplate): the logo on the dark band, then the email's blocks on white, a large heading as the green banner. The Forms plugin repeats the answers row once per answer and fills the {{tokens}}. Mail clients need tables and inline styles, so this uses nothing else. %>
<% c = {page: "#f5f5f5", card: "#ffffff", ink: "#051c23", muted: "#4b5563", label: "#6b7280", rule: "#e5e7eb", green: "#349d41", dark: "#051c23"} %>
<% sans = "Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif" %>
<% name = affordabox_name %>
<% home = website_url("/") %>
<% logo = website_image_url(website_global(:site_settings).logo_white, width: 280) %>
<% phone = website_global(:site_settings).toll_free.presence %>
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= email.subject %></title>
  </head>
  <body style="margin:0;padding:0;background:<%= c[:page] %>;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:<%= c[:page] %>;">
      <tr>
        <td align="center" style="padding:24px 12px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;">
            <tr>
              <td align="center" style="background:<%= c[:dark] %>;padding:36px 20px;">
                <a href="<%= home %>" style="text-decoration:none;color:#ffffff;font-family:<%= sans %>;font-size:22px;font-weight:700;">
                  <% if logo %>
                    <%= image_tag logo, alt: name, width: 140, style: "display:block;width:140px;height:auto;border:0;" %>
                  <% else %>
                    <%= name %>
                  <% end %>
                </a>
              </td>
            </tr>
            <% email.content_blocks.each_with_index do |block, index| %>
              <%# herb:key index %>
              <%= render "website/emails/block", block:, c:, sans: %>
            <% end %>
            <tr>
              <td align="center" style="background:<%= c[:dark] %>;padding:24px 20px;font-family:<%= sans %>;font-size:13px;line-height:1.6;color:#cbd5e1;">
                <%= name %><% if phone %> &middot; <a href="tel:<%= phone.gsub(/[^\d+]/, "") %>" style="color:#ffffff;text-decoration:none;"><%= phone %></a><% end %> &middot; <a href="<%= home %>" style="color:#ffffff;text-decoration:none;"><%= home.sub(%r{\Ahttps?://}, "").chomp("/") %></a>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
